---
import { Icon } from 'astro-icon/components';
import Table from '../components/Table.astro';
import { Content, frontmatter } from '../paper.mdx';
import '../styles/global.css';
import '../styles/apm.css';
import 'katex/dist/katex-swap.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const authors = [
  ['Jialong Liu','1,2'],['Junjie He','2'],['Yandu Chen','1,3'],['Bin Zhou','1,4'],
  ['Heng Su','1,5'],['Peijun Tang','1'],['Jianan Wang','1'],['Changhao Chen','2']
];
const title = frontmatter.title;
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={frontmatter.description} />
  <meta name="theme-color" content="#126976" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={frontmatter.description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(`${base}/images/teaser.webp`,Astro.site).href} />
  <link rel="canonical" href={Astro.url} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <title>APM — Anchored Path Matching</title>
</head>
<body>
  <a class="skip-link" href="#overview">Skip to content</a>
  <nav class="site-nav" aria-label="Main navigation">
    <a class="brand" href="#top"><img src={`${base}/favicon.svg`} width="27" height="27" alt="" />APM</a>
    <div><a href="#method">Method</a><a href="#results">Results</a><a href="#real-world">Real world</a><a href="#citation">Cite</a></div>
  </nav>
  <header id="top" class="hero">
    <p class="eyebrow">ANCHORED PATH MATCHING</p>
    <h1>Distilling World Action Models<br class="desktop-break" /> for Efficient Bimanual Manipulation<br class="desktop-break" /> <span>via Anchored Path Matching</span></h1>
    <div class="authors">
      {authors.map(([name,notes])=><span>{name}<sup>{notes}{name==='Changhao Chen' && <a href="mailto:changhaochen@hkust-gz.edu.cn" aria-label="Email corresponding author Changhao Chen"><Icon name="ri:mail-line" /></a>}</sup></span>)}
    </div>
    <div class="affiliations">
      <span><sup>1</sup>Astribot</span><span><sup>2</sup>The Hong Kong University of Science and Technology (Guangzhou)</span>
      <span><sup>3</sup>Harbin Institute of Technology</span><span><sup>4</sup>The Hong Kong University of Science and Technology</span><span><sup>5</sup>Chongqing University</span>
    </div>
    <a class="correspondence" href="mailto:changhaochen@hkust-gz.edu.cn"><Icon name="ri:mail-line" /> Corresponding author: changhaochen@hkust-gz.edu.cn</a>
    <div class="resource-links">
      <a href={`${base}/paper.pdf`}><Icon name="ri:file-pdf-2-line" />Paper</a>
      <a href="https://github.com/JIAlonglong/Anchored-Path-Matching"><Icon name="ri:github-fill" />Code</a>
      <a href="https://huggingface.co/JIAlonglong/Anchored-Path-Matching"><img src={`${base}/huggingface.svg`} width="21" height="21" alt="" />Hugging Face</a>
    </div>
  </header>
  <main class="prose prose-lg max-w-none prose-headings:tracking-tight prose-a:text-teal-700 prose-a:no-underline prose-a:hover:underline prose-strong:font-semibold">
    <Content components={{table: Table}} />
  </main>
  <footer class="site-footer"><a class="brand" href="#top">APM <span>Anchored Path Matching</span></a><p>Website adapted from <a href="https://github.com/JIAlonglong/REAL_wb">REAL_wb</a> and <a href="https://research-template.roman.technology">Roman Hauksson-Neill’s academic project template</a>.<br/>Template licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</p></footer>
</body>
</html>
